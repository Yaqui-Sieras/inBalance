---
// @pages/demo/index.astro
import MainLayout from '@layouts/MainLayout.astro';

const titlePage = 'InBalance | CargaDemo';
const description = 'Pagina de carga de datos de demostracion.';
---

<MainLayout titlePage={titlePage} description={description}>
  <section class="demo">
    <header class="demo__header">
      <a href="/" class="header__back_link">
        ← Volver al Dashboard
      </a>
      <h1 class="header__title">Datos de prueba</h1>
    </header>
    <div class="demo__content">
      <button type="button" class="demo__btn_load" id="btn_load">
        Cargar Datos de Prueba
      </button>
    </div>
  </section>
</MainLayout>

<script>
  const btn_load = document.getElementById('btn_load');

  btn_load?.addEventListener('click', async () => {
    try {
      // Deshabilitamos el botón mientras carga para evitar múltiples clics
      btn_load.setAttribute('disabled', 'true');

      if (btn_load.textContent !== 'Datos de Prueba Cargados') {
        btn_load.textContent = 'Cargando datos...';

        const response = await fetch('/api/cargar-demo/', {
          method: 'POST',
        });

        const rawText = await response.text();
        let result;

        try {
          result = JSON.parse(rawText);
        } catch (e) {
          console.error('El servidor no devolvió un JSON válido:', rawText);
          throw new Error(
            'Error interno en el servidor (revisa la terminal de Node).',
          );
        }

        if (response.ok) {
          alert('¡Datos de prueba cargados con éxito!');
          btn_load.textContent = 'Datos de Prueba Cargados';
        } else {
          alert('Hubo un error: ' + (result.error || 'Desconocido'));
        }
      } else {
        alert('Los datos de prueba ya fueron cargados');
      }
    } catch (error) {
      console.error(error);
      alert('Ocurrió un error de red al intentar cargar los datos.');
      btn_load.textContent = 'Cargar Datos de Prueba';
    } finally {
      // Restauramos el botón
      btn_load.removeAttribute('disabled');
    }
  });
</script>

<style>
  .demo {
    width: 100%;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
  }

  .demo__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .header__back_link {
    color: #3b82f6;
    text-decoration: none;
    font-size: 0.9rem;

    &:hover {
      text-decoration: underline;
    }
  }

  .header__title {
    color: #f4f4f5;
    font-size: 1.75rem;
  }

  .demo__content {
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

