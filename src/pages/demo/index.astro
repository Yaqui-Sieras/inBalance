---
// @pages/index.astro
import PublicLayout from '@layouts/BaseLayout.astro';
import Box from '@/components/UI/Common/Box.astro';

const titlePage = 'InBalance | Dashboard';
const description = 'Panel de control principal de inBalance.';
---

<PublicLayout titlePage={titlePage} description={description}>
  <Box as="section" class={'demo_page'}>
    <h2 class={'demo_page__title'}>🚧 Demo en construccin 🚧</h2>
    <p class={'demo_page__desciption'}>
      Publicaremos su lanzamiento en un futuro, lamentamos los inconvenientes.
    </p>
  </Box>
</PublicLayout>

<style>
  .demo_page {
    flex: 1;
    flex-direction: column;
    justify-content: start;
    gap: 0.8rem;
  }

  .demo_page__title {
    text-align: center;
  }

  .demo_page__description {
    text-align: center;
  }
</style>
