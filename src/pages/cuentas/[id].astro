---
// @pages/cuentas/[id].astro
import MainLayout from '@layouts/MainLayout.astro';
//import { LibroMayor } from '@lib/libroMayor.ts';
import type { Account } from '@types-local/contabilidad';
import { randomInt } from 'node:crypto';

export const prerender = false;
// 1. Capturamos el parámetro dinámico de la URL (ej: /cuentas/123 -> id = "123")
const { id } = Astro.params;

/*
// 2. Buscamos la información de esa cuenta específica
const libroM = new LibroMayor();
// Supongamos que tienes un método para buscar por ID, o filtras el array:
const cuenta = libroM.getAccountById(id); 

// Si la cuenta no existe, puedes redirigir o mostrar un 404
if (!cuenta) {
  return Astro.redirect('/404');
}
*/

if (!id) {
  return Astro.redirect('/404');
}

const cuenta: Account = {
  id: id,
  name: '',
  nature: { label: 'patrimonio', group: 'balance', behavior: 'acreedora' },
  balance: randomInt(0, 100000),
};
---

<MainLayout
  titlePage={`InBalance | Cuenta ${cuenta.name}`}
  description={`Detalles y movimientos de la cuenta ${cuenta.name}`}
>
  <div class="cuenta-detalle-view">
    <div class="page-header">
      <a href="/cuentas/" class="back-link">
        ← Volver al Plan de Cuentas
      </a>
      <h1>Detalle de Cuenta: {cuenta.name}</h1>
    </div>

    <div class="detalle-content">
      <p>
        <strong>ID de Cuenta:</strong> {id}
      </p>
      <p>
        <strong>Saldo Actual:</strong> ${cuenta.balance}
      </p>
      <!-- Aquí puedes mostrar más detalles, tablas de transacciones de esta cuenta, etc. -->
    </div>
  </div>
</MainLayout>

<style>
  .cuenta-detalle-view {
    width: 100%;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .back-link {
    color: #3b82f6;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  h1 {
    color: #f4f4f5;
    font-size: 1.75rem;
    margin: 0;
  }

  .detalle-content {
    background-color: #18181b;
    padding: 1.5rem;
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
