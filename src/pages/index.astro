---
import MainLayout from '@layouts/MainLayout.astro';

const titlePage = 'InBalance | Inicio';
const description =
  'Website de InBalance, una plataforma contable por partida doble para la gestión financiera personal.';
---

<MainLayout titlePage={titlePage} description={description}>
  <section class="section_principal">
    <h1>Astro</h1>
  </section>
</MainLayout>

<style>
  .section_principal {
    width: calc(100dvw - 4rem);
    min-height: calc(100dvh - 4rem);
    background-color: #161618;
    margin: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>
