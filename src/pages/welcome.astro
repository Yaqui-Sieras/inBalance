---
// @pages/welcome.astro
import WelcomeLayout from '@layouts/WelcomeLayout.astro';
import Box from '@components/UI/Common/Box.astro';

import WelcomeHeader from '@components/Welcome/WelcomeHeader.astro';
import WelcomeProfileSelection from '@components/Welcome/WelcomeProfileSelection.astro';
import WelcomeActions from '@components/Welcome/WelcomeActions.astro';

import UserForm from '@components/Welcome/UserForm.astro';

const titlePage = 'InBalance | Acceso';
const description =
  'Configuración inicial y gestión de perfiles locales en inBalance.';
---

<WelcomeLayout titlePage={titlePage} description={description}>
  <Box class="welcome_view">
    <WelcomeHeader />

    <Box id="welcome-card" class="welcome_view__content">
      <!-- Estado de Carga Inicial -->
      <WelcomeProfileSelection id="welcome-profile-selection" />

      <WelcomeActions id="welcome-actions" />

      <!-- Formulario de creación de usuario (Gestionado por los scripts) -->
      <UserForm
        id="form-create-user"
        mode="create"
        style={{ display: 'none' }}
      />

      <!-- Formulario de login de usuario (Gestionado por los scripts) -->
      <UserForm id="form-login-user" mode="login" style={{ display: 'none' }} />
    </Box>
  </Box>
</WelcomeLayout>

<script>
  import { motorContable } from '@/lib/LedgerManager';
  import { checkAuthOrRedirect } from '@lib/authGuard';
  import { initWelcomePage } from '@scripts/renderWelcome';

  if (typeof window !== 'undefined') {
    checkAuthOrRedirect(window.location.pathname).then(() => {
      initWelcomePage(motorContable);
    });
  }
</script>

<style>
  .welcome_view {
    flex: 1;
    flex-direction: column;
    justify-content: start;
    gap: 1.5rem;
  }

  .welcome_view__content {
    max-width: 480px;
    background: #1f1f23;
    padding: 1rem 1.5rem;
    border-radius: 0.75rem;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.8rem;
  }
</style>
