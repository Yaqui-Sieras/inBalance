---
// src/pages/cuentas/detalle.astro
import AppLayout from '@layouts/AppLayout.astro';
import HeaderSection from '@components/UI/HeaderSection.astro';
---

<AppLayout
  titlePage="InBalance | Detalle de Cuenta"
  description="Detalles y movimientos de la cuenta"
>
  <div class="vista_cuenta">
    <HeaderSection>
      <span id="nombre_cuenta">Cargando cuenta...</span>
    </HeaderSection>

    <div class="vista_cuenta__detalles">
      <p>
        <strong>ID de Cuenta:</strong> <span id="id_cuenta"> ----- </span>
      </p>
      <p>
        <strong>Saldo Actual:</strong> $<span id="saldo_cuenta">0.00</span>
      </p>
    </div>
  </div>
</AppLayout>

<script>
  import { renderizarDetalleCuenta } from '@scripts/renderDetalle';
  renderizarDetalleCuenta();
</script>

<style>
  /* Tus estilos limpios de siempre */
  .vista_cuenta {
    width: 100%;
    max-width: 1280px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .vista_cuenta__detalles {
    background-color: #18181b;
    padding: 1.5rem;
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
