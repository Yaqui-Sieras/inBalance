---
// @pages/index.astro
import AppLayout from '@layouts/AppLayout.astro';

const titlePage = 'InBalance | Dashboard';
const description = 'Panel de control principal de inBalance.';
---

<AppLayout titlePage={titlePage} description={description}>
  <section class="dashboard">
    <!-- Tarjetas de Resumen Rápido (KPIs) -->
    <div class="dashboard__kpis">
      <div class="kpi__card">
        <h3>Total Débitos</h3>
        <p class="kpi__amount" id="kpi_debit">
          $0.00
        </p>
      </div>
      <div class="kpi__card">
        <h3>Total Créditos</h3>
        <p class="kpi__amount" id="kpi_credit">
          $0.00
        </p>
      </div>
      <div class="kpi__card">
        <h3>Balance</h3>
        <p class="kpi__amount" id="kpi_imbalance">
          $0.00
        </p>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  import { checkAuthOrRedirect } from '@lib/authGuard';
  // import { renderizarDashboard } from '@utils/renderDashboard';

  // Ejecutamos la comprobación apenas carga el script en el navegador
  if (typeof window !== 'undefined') {
    checkAuthOrRedirect(window.location.pathname).then(() => {
      console.log('[Guard] Acceso autorizado a la página actual.');
      // renderizarDashboard();
    });
  }
</script>

<style>
  .dashboard {
    width: 100%;
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .dashboard__kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .kpi__card {
    background: #1f1f23;
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid #27272a;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kpi__card h3 {
    font-size: 0.85rem;
    color: #a1a1aa;
    text-transform: uppercase;
  }

  .kpi__amount {
    font-size: 1.5rem;
    font-family: monospace;
    font-weight: bold;
    color: #f4f4f5;
  }

