---
// @pages/acceso/index.astro
import AccessLayout from '@layouts/BaseLayout.astro';
import Box from '@components/UI/Common/Box.astro';

import AccesoHeader from '@components/Acceso/AccesoHeader.astro';
import AccesoProfileSelection from '@components/Acceso/AccesoProfileSelection.astro';
import AccesoActions from '@components/Acceso/AccesoActions.astro';

const titlePage = 'InBalance | Acceso';
const description =
  'Configuración inicial y gestión de perfiles locales en inBalance.';
---

<AccessLayout titlePage={titlePage} description={description}>
  <Box class="acceso_view">
    <AccesoHeader />

    <Box class="acceso_view__content">
      <!-- Estado de Carga Inicial -->
      <AccesoProfileSelection />

      <AccesoActions />
    </Box>
  </Box>
</AccessLayout>

<script>
  import { checkAuthOrRedirect } from '@lib/authGuard';

  if (typeof window !== 'undefined') {
    checkAuthOrRedirect(window.location.pathname).then(() => {});
  }
</script>

<style>
  .acceso_view {
    flex: 1;
    flex-direction: column;
    justify-content: start;
    gap: 1.5rem;
  }

  .acceso_view__content {
    max-width: 480px;
    background: #1f1f23;
    padding: 1rem 1.5rem;
    border-radius: 0.75rem;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.8rem;
  }
</style>
