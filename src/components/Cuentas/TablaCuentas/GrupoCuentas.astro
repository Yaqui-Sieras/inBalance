---
// @components/Home/PanelContable/TablaCuentas/GrupoCuentas.astro
import type { Account, AccountNature } from '@types-local/contabilidad';
import { ACCOUNT_NATURE_CONFIG } from '@constants/contabilidadConfig';

interface Props {
  nature: AccountNature;
}

const { nature } = Astro.props;

/*
{tieneCuentas ? (
  items.map((cuenta) => {
    const esAcreedora = cuenta.nature.behavior === 'acreedora';
    return (
      <tr>
        <td class="cuenta__column cuenta__label">
          <a href={`/cuentas/detalle?id=${cuenta.id}`} style="color: inherit; text-decoration: none;">
            {cuenta.name}
          </a>
        </td>
        <td class="cuenta__column cuenta__amount">
          {!esAcreedora ? `$${cuenta.balance.toFixed(2)}` : '-'}
        </td>
        <td class="cuenta__column cuenta__amount">
          {esAcreedora ? `$${cuenta.balance.toFixed(2)}` : '-'}
        </td>
      </tr>
    );
  })
)
*/
---

<table class={`grupo_cuentas grupo__cuentas--${nature}`}>
  <caption class="grupo_cuentas__caption">{nature.toUpperCase()}</caption>
  <colgroup>
    <col style="width: 50%;" />
    <col style="width: 25%;" />
    <col style="width: 25%;" />
  </colgroup>
  <thead class="grupo_cuentas__header">
    <tr>
      <th class="header__titulos">Cuenta</th>
      <th class="header__titulos">Débito</th>
      <th class="header__titulos">Crédito</th>
    </tr>
  </thead>
  <tbody class="grupo_cuentas__body" id=`cuentas_${nature}`>
    <tr>
      <td colspan="3" class="cuenta__column empty-section cuenta__label">
        Sin cuentas
      </td>
    </tr>
  </tbody>
  <tfoot class="grupo__footer">
    <tr>
      <td class="footer__column cuenta__label">Total</td>
      <td
        colspan="2"
        class="footer__column cuenta__amount grupo_cuentas__total_amount"
        id=`total_${nature}`
      >
        -
      </td>
    </tr>
  </tfoot>
</table>

<style>
  .grupo__cuentas {
    width: 100%;
    border-collapse: collapse;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #111827;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
  }

  .grupo_cuentas__caption {
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.6rem 1rem;
    text-align: left;
    background: #1f2937;
    color: #f3f4f6;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .header__titulos {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    background: #181b20;
    color: #9ca3af;
    border-bottom: 1px solid #374151;
  }

  .cuenta__column {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #1f2937;
    font-size: 0.9rem;
  }

  .cuenta__label {
    text-align: center;
    color: #9ca3af;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .cuenta__amount {
    text-align: right;
    font-family: monospace;
    font-weight: 600;
    color: #f9fafb;
  }

  .empty-section {
    font-size: 0.8rem;
    font-style: italic;
    color: #6b7280;
  }

  .grupo_cuentas__footer {
    background: #161b22;
    font-weight: 600;
  }

  .footer__column {
    padding: 0.6rem 0.75rem;
    border-top: 1px solid #374151;
  }

  .grupo_cuentas__total_amount {
    text-align: center;
  }
</style>
