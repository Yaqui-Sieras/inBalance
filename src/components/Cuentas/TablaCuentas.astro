---
// @components/home/TablaCuentas.astro
import type { Account } from '@types-local/contabilidad';
import GrupoCuentas from '@components/Cuentas/TablaCuentas/GrupoCuentas.astro';

interface Props {
  cuentas: Account[];
}

const { cuentas } = Astro.props;
---

<div class="secciones__grid">
  <div class="grid__columna">
    <GrupoCuentas nature="ingreso" cuentas={cuentas} />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="activo" cuentas={cuentas} />
    <GrupoCuentas nature="pasivo" cuentas={cuentas} />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="patrimonio" cuentas={cuentas} />
    <GrupoCuentas nature="transitoria" cuentas={cuentas} />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="gasto" cuentas={cuentas} />
    <GrupoCuentas nature="costo" cuentas={cuentas} />
  </div>
</div>

<style>
  .secciones__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .grid__columna {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>

