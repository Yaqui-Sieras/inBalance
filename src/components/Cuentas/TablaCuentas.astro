---
// @components/home/TablaCuentas.astro
import type { Account } from '@types-local/contabilidad';
import GrupoCuentas from '@components/Cuentas/TablaCuentas/GrupoCuentas.astro';
---

<div class="secciones__grid">
  <div class="grid__columna">
    <GrupoCuentas nature="ingreso" />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="activo" />
    <GrupoCuentas nature="pasivo" />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="patrimonio" />
    <GrupoCuentas nature="transitoria" />
  </div>
  <div class="grid__columna">
    <GrupoCuentas nature="gasto" />
    <GrupoCuentas nature="costo" />
  </div>
</div>

<style>
  .secciones__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  .grid__columna {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>

