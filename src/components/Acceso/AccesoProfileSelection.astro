---
// @components/Acceso/LoadingView.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';
import Box from '@components/UI/Common/Box.astro';

import LoadingPlaceholder from '@components/Acceso/ProfileSelection/LoadingPlaceholder.astro';
import NotProfilePlaceholder from '@components/Acceso/ProfileSelection/NotProfilePlaceholder.astro';
import ProfileListPlaceholder from '@components/Acceso/ProfileSelection/ProfileListPlaceholder.astro';

interface Props extends HTMLAttributes<'div'> {
  style?: Properties;
}

const {
  id: idName = '',
  class: className = '',
  style: userStyle,
} = Astro.props;
---

<Box
  id={idName}
  class:list={['profile_selection', className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
>
  <header class="profile_selection__header">
    <h2 class="header__title">Perfiles del dispositivo</h2>
    <h3 class="header__subtitle">Elige qué perfil operará en esta sesión.</h3>
  </header>

  <Box class="profile_selection__contend">
    <LoadingPlaceholder
      id="loading-placeholder"
      text="Buscando perfiles en este dispositivo ..."
    />

    <NotProfilePlaceholder
      id="not-profile-placeholder"
      style={{ display: 'none' }}
    />

    <ProfileListPlaceholder
      id="profile-list-container"
      style={{ display: 'none' }}
    />
  </Box>
</Box>

<script>
  import type { LedgerManager } from '@lib/LedgerManager.ts';
  import { ROUTES } from '@constants/routes';
  import { ejecutarRenderSeguro } from '@scripts/baseRender';

  await ejecutarRenderSeguro(async (ledgerEngine: LedgerManager) => {
    const users = ledgerEngine.getUsers();

    document.getElementById('loading-placeholder')!.style.display = 'none';

    if (users.length === 0) {
      document.getElementById('not-profile-placeholder')!.style.display =
        'flex';
    } else {
      const container = document.getElementById('profile-list-container')!;
      const template = document.getElementById(
        'profile-template',
      ) as HTMLTemplateElement;
      container.style.display = 'flex';

      users.forEach((user) => {
        const clone = template.content.cloneNode(true) as HTMLElement;
        clone.querySelector('.profile_avatar')!.textContent = user.avatar;
        clone.querySelector('.profile_name')!.textContent = user.name;

        clone.querySelector('.profile')!.addEventListener('click', () => {
          window.location.href = `${ROUTES.LOGINUSER}?id=${user.id}`;
        });

        container.appendChild(clone);
      });
    }
  }, 'Módulo de Acceso');
</script>

<style>
  .profile_selection {
    flex: 1;
    flex-direction: column;
    justify-content: start;
    gap: 0.8rem;
  }

  .profile_selection__header {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header__title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .header__subtitle {
    font-size: 1rem;
    color: #b1b1ba;
  }

  .profile_selection__contend {
    background-color: #18181a;
    padding: 0.5rem 0.7rem;
    border-radius: 0.5rem;
    flex: 1;
    flex-direction: column;
  }
</style>
