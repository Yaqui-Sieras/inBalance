---
// @components/UI/Common/Input.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';

interface Props extends HTMLAttributes<'input'> {
  style?: Properties;
}

const {
  id: idName = '',
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;
---

<input
  id={idName}
  class:list={['ui_input', className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  {...rest}
/>

<style>
  .ui_input {
    width: 100%;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    transition: all 0.2s ease;

    &:focus {
      outline: none;
      border-color: #3b82f6;
    }

    &:disabled,
    &[aria-disabled='true'] {
      cursor: not-allowed;
      opacity: 0.8;
    }
  }
</style>
