---
// @components/UI/Common/Button.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  style?: Properties;
}

const {
  id: idName = '',
  type = 'button',
  variant = 'primary',
  disabled,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;
---

<button
  id={idName}
  type={type}
  disabled={disabled}
  class:list={['ui_button', `ui_button--${variant}`, className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  {...rest}
>
  <slot />
</button>

<style>
  .ui_button {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    text-decoration: none;
    transition: all 0.2s ease;

    &:focus {
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.4);
    }

    &:disabled,
    &[aria-disabled='true'] {
      color: #9ca3af;
      opacity: 0.7;
      cursor: not-allowed;
      pointer-events: none;
    }
  }

  .ui_button--primary {
    background: #2563eb;
    border: 1px solid #3f3f46;

    &:hover {
      background: #1d4ed8;
    }

    &:focus {
      background: #1d4ed8;
    }

    &:active {
      background: #1e40af;
    }
  }

  .ui_button--ghost {
    color: #a1a1aa;
    background: transparent;
    border: 1px solid #3f3f46;

    &:hover {
      background: rgba(255, 255, 255, 0.06);
    }

    &:focus {
      background: rgba(255, 255, 255, 0.06);
    }

    &:active {
      background: rgba(255, 255, 255, 0.03);
    }
  }
</style>
