---
// @components/UI/Common/Button.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';
import type { StyleProps } from '@types-local/commonUI';
import { getCssVariables } from '@utils/commonUIUtils';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  baseCSS?: StyleProps;
  hoverCSS?: StyleProps;
  focusCSS?: StyleProps;
  activeCSS?: StyleProps;
  disabledCSS?: StyleProps;
  style?: Properties;
}

const {
  type = 'button',
  variant = 'primary',
  size = 'md',
  baseCSS = {},
  hoverCSS = {},
  focusCSS = {},
  activeCSS = {},
  disabledCSS = {},
  disabled,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;
---

<button
  type={type}
  disabled={disabled}
  class:list={[
    'ui_button',
    `ui_button--${variant}`,
    `ui_button--${size}`,
    className,
  ]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
    // Inyectamos las variables de los objeto de Pseudoclases
    ...getCssVariables('base', baseCSS),
    ...getCssVariables('hover', hoverCSS),
    ...getCssVariables('focus', focusCSS),
    ...getCssVariables('active', activeCSS),
    ...getCssVariables('disabled', disabledCSS),
  }}
  {...rest}
>
  <slot />
</button>

<style>
  .ui_button {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--base-font-family, inherit);
    font-weight: var(--base-font-weight, 500);
    font-size: var(--base-font-size, 0.875rem);
    letter-spacing: var(--base-letter-spacing, inherit);
    color: var(--base-color, #ffffff);
    background: var(--base-background, #2563eb);
    padding: var(--base-padding, 0.5rem 1rem);
    border: var(--base-border, 1px solid transparent);
    border-radius: var(--base-border-radius, 0.375rem);
    box-shadow: var(--base-box-shadow, none);
    text-decoration: var(--base-text-decoration, none);
    transition: all 0.2s ease;

    &:hover {
      font-family: var(--hover-font-family, var(--base-font-family, inherit));
      font-weight: var(--hover-font-weight, var(--base-font-weight, 500));
      font-size: var(--hover-font-size, var(--base-font-size, 0.875rem));
      color: var(--hover-color, var(--base-color, #ffffff));
      background: var(--hover-background, var(--base-background, #1d4ed8));
      padding: var(--hover-padding, var(--base-padding, 0.5rem 1rem));
      border: var(--hover-border, var(--base-border, 1px solid transparent));
      border-radius: var(
        --hover-border-radius,
        var(--base-border-radius, 0.375rem)
      );
      box-shadow: var(--hover-box-shadow, var(--base-box-shadow, none));
      text-decoration: var(
        --hover-text-decoration,
        var(--base-text-decoration, none)
      );
    }

    &:focus {
      outline: none;
      color: var(--focus-color, var(--base-color, #ffffff));
      background: var(--focus-background, var(--base-background, #1d4ed8));
      border: var(--focus-border, var(--base-border, 1px solid transparent));
      box-shadow: var(--focus-box-shadow, 0 0 0 3px rgba(37, 99, 235, 0.4));
    }

    &:active {
      color: var(--active-color, var(--base-color, #ffffff));
      background: var(--active-background, var(--base-background, #1e40af));
      border: var(--active-border, var(--base-border, 1px solid transparent));
    }

    &:disabled,
    &[aria-disabled='true'] {
      color: var(--disabled-color, #9ca3af);
      background: var(--disabled-background, #e5e7eb);
      border: var(--disabled-border, 1px solid transparent);
      opacity: 0.7;
      cursor: not-allowed;
      pointer-events: none;
    }
  }
</style>
