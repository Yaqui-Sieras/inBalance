---
// @components/UI/Common/Link.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';
import { isExternalUrl } from '@utils/url';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  style?: Properties;
}

const {
  id: idName = '',
  href,
  target,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;

const isExternal = isExternalUrl(href);
const finalTarget = target ?? (isExternal ? '_blank' : '_self');
const rel = finalTarget === '_blank' ? 'noopener noreferrer' : undefined;
---

<a
  id={idName}
  class:list={['ui_link', className]}
  href={href}
  target={finalTarget}
  rel={rel}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  {...rest}
>
  <slot />
</a>

<style>
  .ui_link {
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s ease;

    &:disabled,
    &[aria-disabled='true'] {
      color: #a3a3a3;
      background: transparent;
      opacity: 0.6;
      pointer-events: none;
    }
  }
</style>
