---
// @components/UI/Common/Img.astro
import type { HTMLAttributes } from 'astro/types';
import type { ImageMetadata } from 'astro';
import type { Properties } from 'csstype';

interface Props extends HTMLAttributes<'img'> {
  imgMd?: ImageMetadata;
  src?: string;
  alt: string;
  style?: Properties;
}

const {
  id: idName = '',
  imgMd,
  src,
  alt,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;

const imageSrc = typeof imgMd !== 'undefined' ? imgMd.src : src;
---

{imageSrc ? (
  <img
    id={idName}
    src={imageSrc}
    alt={alt}
    class:list={['ui_img', className]}
    style={{
      ...(typeof userStyle === 'object' ? userStyle : {}),
    }}
    {...rest}
  />
) : (
  <p>No llega el src de la imagen</p>
)}

<style>
  .ui_img {
    max-width: 100%;
    object-fit: cover;
    transition: all 0.2s ease;
  }
</style>
