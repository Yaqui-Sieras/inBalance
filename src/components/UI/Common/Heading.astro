---
// @components/UI/Common/Heading.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';

type HeadingTag = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

interface Props extends HTMLAttributes<'h1'> {
  as?: HeadingTag;
  style?: Properties;
}

const {
  as: Tag = 'h2',
  id: idName = '',
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;

const hType = Tag.replace('h', '');
---

<Tag
  id={idName}
  class:list={['ui_heading', `ui_heading--h${hType}`, className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  {...rest}
>
  <slot />
</Tag>

<style>
  .ui_heading {
    font-weight: 700;
    transition: all 0.2s ease;
  }

  /* Tamaños escalados para títulos */
  .ui_heading--h1 {
    font-size: 2.5rem;
    line-height: 1.1;
  }
  .ui_heading--h2 {
    font-size: 2rem;
    line-height: 1.2;
  }
  .ui_heading--h3 {
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .ui_heading--h4 {
    font-size: 1.25rem;
    line-height: 1.4;
  }
  .ui_heading--h5 {
    font-size: 1rem;
    line-height: 1.5;
  }
  .ui_heading--h6 {
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
