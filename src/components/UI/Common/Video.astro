---
// @components/UI/Common/Video.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';

interface Props extends HTMLAttributes<'video'> {
  src: string;
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  controls?: boolean;
  style?: Properties;
}

const {
  id: idName = '',
  src,
  autoplay = false,
  loop = false,
  muted = false,
  controls = true,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;
---

<video
  id={idName}
  src={src}
  autoplay={autoplay}
  loop={loop}
  muted={muted}
  controls={controls}
  class:list={['ui_video', className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  {...rest}
>
  Tu navegador no soporta el elemento de video.
</video>

<style>
  .ui_video {
    max-width: 100%;
    width: 100%;
    display: block;
    border-radius: 1rem;
  }
</style>
