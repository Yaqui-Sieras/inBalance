---
// @components/UI/Common/Navigation.astro
import type { HTMLAttributes } from 'astro/types';
import type { Properties } from 'csstype';

import type { NavItem } from '@types-local/routes';
import Link from '@components/UI/Common/Link.astro';

interface Props extends HTMLAttributes<'nav'> {
  links: readonly NavItem[];
  ariaLabel?: string;
  // Relacionado con el contenedor
  navClass?: string;
  navStyle?: Properties;
  style?: Properties;
  // Relacionado con los estilos configurables de los links

  linkClass?: string;
  linkStyle?: Properties;
  linkCurrentClass?: string;
  linkCurrentStyle?: Properties;
}

const {
  links,
  ariaLabel = 'Navegación',
  navClass,
  class: className = '',
  navStyle,
  style: userStyle,
  linkClass = '',
  linkStyle,
  linkCurrentClass,
  linkCurrentStyle,
  ...rest
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<nav
  aria-label={ariaLabel}
  class:list={['navigation', navClass, className]}
  {...rest}
>
  <ul
    class="nav_list"
    style={{
      ...(typeof navStyle === 'object' ? navStyle : {}),
      ...(typeof userStyle === 'object' ? userStyle : {}),
    }}
  >
    {links.map(({ label, href, target, icon }: NavItem) => {
      const isExternal = href.startsWith('https://');
      const targetPathname = isExternal ? new URL(href).pathname : href;

      const isCurrent =
        targetPathname === '/'
          ? currentPath === '/'
          : currentPath.startsWith(targetPathname);

      return (
        <li class="nav_item">
          <Link
            href={href}
            target={target}
            class:list={['item_a', linkClass, { linkCurrentClass: isCurrent }]}
            style={{ ...linkStyle }}
          >
            {label == '' && icon}
            {label}
          </Link>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  :where(.navigation, ) {
    height: inherit;
    display: flex;
    align-items: center;
  }

  :where(.nav_list, ) {
    list-style: none;
    height: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :where(.nav_item, ) {
    height: inherit;
    display: flex;
    align-items: center;
  }

  :where(.item_a, ) {
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-bottom: 5px solid transparent;
  }
</style>
