---
// @components/UI/HeaderPage/HeaderPrivate.astro
import Box from '@components/UI/Common/Box.astro';
import Navigation from '@components/UI/Common/Navigation.astro';
import { APP_NAV_ITEMS } from '@constants/routes';
import HomeLink from '@components/UI/HeaderPage/HomeLink.astro';
---

<Box class={'header_page__Container'}>
  <HomeLink />
  <Navigation
    links={APP_NAV_ITEMS}
    navClass={'header_page__nav'}
    linkClass={'nav_item'}
    linkCurrentClass={'nav_item--current'}
  />
</Box>

<style>
  .header_page__Container {
    justify-content: space-between;
  }

  .header_page__nav {
    align-self: end;
    gap: 1.25rem;
  }

  .nav_item:hover {
    color: #2563eb;
    border-bottom: 5px solid #2563eb;
  }

  .nav_item--current {
    color: #2563eb;
    border-bottom: 5px solid #2563eb;
  }
</style>
