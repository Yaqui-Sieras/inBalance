---
// @components/UI/HeaderPage/LogoApp.astro
import Link from '@components/UI/Common/Link.astro';
import { ROUTES } from '@constants/routes';
---

<Link href={ROUTES.LANDING} class="logo_app">
  <h1 class="logo_app__title">📊 inBalance</h1>
  <p class="logo_app__subtitle">Tu salud financiera de un vistazo</p>
</Link>

<style>
  .logo_app {
    padding: 0.5rem;
  }

  .logo_app__title {
    font-size: 1.2rem;
    color: #3b82f6;
  }

  .logo_app__subtitle {
    font-size: 1rem;
    color: #a1a1aa;
  }
</style>
