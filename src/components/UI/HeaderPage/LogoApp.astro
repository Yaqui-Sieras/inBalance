---
// @components/UI/HeaderPage/LogoApp.astro
import Box from '@components/UI/Common/Box.astro';
import InBalanceSvg from '@/assets/imgs/svg/InBalanceSvg.astro';
const IconAlt = '📊';
---

<Box class={'logo_app__svg'}>
  <Box class="svg__container">{InBalanceSvg ? <InBalanceSvg /> : IconAlt}</Box>
</Box>

<style>
  .logo_app__svg {
    width: 2.5rem;
    height: 2.5rem;
    color: #60a5fa;
    background-image: linear-gradient(to top right, #2563eb, #3b82f6, #818cf8);
    padding: 1px;
    border-radius: 0.75rem;
    flex-shrink: 0;
    box-shadow:
      0 10px 15px -3px rgba(59, 130, 246, 0.2),
      0 4px 6px -4px rgba(59, 130, 246, 0.2);
  }

  .svg__container {
    width: 100%;
    height: 100%;
    background-color: #0f172a;
    border-radius: 0.75rem;
  }
</style>
