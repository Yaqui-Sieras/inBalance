---
// @components/UI/HeaderPage/LogoApp.astro
import Link from '@components/UI/Common/Link.astro';
import Box from '@components/UI/Common/Box.astro';
import { ROUTES } from '@constants/routes';
import LogoApp from '@components/UI/HeaderPage/LogoApp.astro';
---

<Link href={ROUTES.LANDING} class="home_link">
  <Box style={{ gap: '0.8rem' }}>
    <LogoApp />
    <Box style={{ flexDirection: 'column' }}>
      <Box style={{ justifyContent: 'start', gap: '0.5rem' }}>
        <h1 class="home_link__title">
          In<span class={'title__parte_resaltada'}>Balance</span>
        </h1>
        <span class="home_link__app_version">v0.0.1 ALFA</span>
      </Box>
      <p class="home_link__slogan">Tu salud financiera de un vistazo</p>
    </Box>
  </Box>
</Link>

<style>
  .home_link {
    padding: 0.5rem;
  }

  .home_link__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.75rem;
    letter-spacing: -0.025em;
  }

  .title__parte_resaltada {
    color: #60a5fa;
    /*color: #3b82f6;*/
  }

  .home_link__app_version {
    color: #34d399;
    font-size: 0.75rem;
    background-color: rgb(16 185 129 / 0.1);
    padding: 0.125rem 0.375rem;
    border: 1px solid rgb(16 185 129 / 0.2);
    border-radius: 0.25rem;
    display: inline-flex;
    align-items: center;
  }

  .home_link__slogan {
    width: 100%;
    font-size: 0.75rem;
    line-height: 1rem;
    color: #94a3b8;
    /* color: #a1a1aa; */
  }
</style>
