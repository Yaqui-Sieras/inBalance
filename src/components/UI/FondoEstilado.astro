---
// @components/UI/FondoEstilado
import Box from '@components/UI/Common/Box.astro';
---

<Box class={'fondo_estilado__comun lineas_xy'} />
<Box class={'fondo_estilado__comun gradiente'} />

<style>
  .fondo_estilado__comun {
    pointer-events: none;
    position: fixed;
    z-index: 0;
    inset: 0px;
  }

  .lineas_xy {
    background-size: 32px 32px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    opacity: 0.5;
  }

  .gradiente {
    background: radial-gradient(
      circle at 50% 30%,
      rgba(37, 99, 235, 0.15),
      transparent 70%
    );
  }
</style>
