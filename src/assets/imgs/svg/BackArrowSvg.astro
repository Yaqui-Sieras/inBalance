---
// src/components/BackArrowSvg.astro
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  decorative?: boolean;
}

const {
  id: idName = '',
  width,
  height,
  color = 'currentColor',
  decorative = true,
  class: className = '',
  style: userStyle,
  ...rest
} = Astro.props;
---

<svg
  id={idName}
  class:list={['BackArrow_icon', className]}
  style={{
    ...(typeof userStyle === 'object' ? userStyle : {}),
  }}
  fill="none"
  stroke="currentColor"
  viewBox="0 0 24 24"
  aria-hidden={decorative ? 'true' : undefined}
  {...rest}
>
  <path
    d="M10 19l-7-7m0 0l7-7m-7 7h18"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
  ></path>
</svg>

<style>
  :where(.BackArrow_icon, ) {
    width: 1rem;
    height: 1rem;
    color: currentColor;
    flex-shrink: 0;
  }
</style>
